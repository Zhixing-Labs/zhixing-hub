# PostgreSQL 是唯一结构化事实源；本地值与 deploy/docker-compose.yml 对齐。
DATABASE_URL=postgresql://zhixing:zhixing_dev@localhost:5432/zhixing

# Identity 阶段用于验证码、登录频控与短期锁；不得承载唯一事实。
REDIS_URL=redis://localhost:6379
INTEGRATION_MODE=mock

# 正式环境必填，用于短信验证码 Redis 哈希；应为独立高熵随机值。
VERIFICATION_CODE_PEPPER=

# 服务端不透明会话 Cookie。
SESSION_COOKIE_NAME=zhixing_session
SESSION_TTL_SECONDS=1209600
PLATFORM_ENROLLMENT_TTL_SECONDS=600

# TOTP 密钥使用 AES-256-GCM 加密；生产环境必须由密钥管理生成并注入 32 字节 Base64 值。
# 本地可生成：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=

# 首次部署引导唯一超管。平台管理账号只使用唯一用户名，不绑定手机号、不走短信。
# 执行 pnpm bootstrap:super-admin 后立即离线保存 TOTP/恢复码，并移除明文密码变量。
BOOTSTRAP_SUPER_ADMIN_USERNAME=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
